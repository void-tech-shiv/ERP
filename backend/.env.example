# Local development configuration (do not put passwords or ERP cookies here)
APP_ENV=development
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# IMPORTANT:
# APP_ENV=production enables Secure HttpOnly cookies and requires an Origin.
# APP_ORIGINS must then be set to the exact HTTPS browser application origin.
# Real ERP login routes remain disabled in EVERY environment.

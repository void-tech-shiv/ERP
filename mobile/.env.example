# Attendly Cloudflare staging Worker, protected by Cloudflare Access email OTP.
# ERP login stays disabled until ERP_SESSION_SECRET and the private test flag are
# configured on the Cloudflare Worker and authenticated tests are completed.
# Never put student passwords, CAPTCHA answers, Cloudflare OTPs or session tokens here.
EXPO_PUBLIC_ATTENDLY_URL=https://attendly-cloudflare-preview.void-tech-shiv.workers.dev/

# Exact approved Cloudflare Access OTP origin. The mobile WebView blocks all
# other cross-origin navigation and will not open arbitrary login websites.
EXPO_PUBLIC_CLOUDFLARE_ACCESS_ORIGIN=https://wild-cell-527b.cloudflareaccess.com
